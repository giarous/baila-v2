{
  "name": "TBaila",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.tbaila.v2",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.cjs",
    "start": "react-native start",
    "test": "jest",
    "screenshots": "npm --prefix tools/ui-previews run capture",
    "format": "prettier --write App.js \"src/**/*.js\" \"tools/ui-previews/*.{cjs,jsx,json}\" README.md \"docs/*.md\" \".github/workflows/*.yml\" package.json",
    "format:check": "prettier --check App.js \"src/**/*.js\" \"tools/ui-previews/*.{cjs,jsx,json}\" README.md \"docs/*.md\" \".github/workflows/*.yml\" package.json"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-safe-area-context)/)"
    ],
    "testTimeout": 15000
  }
}
